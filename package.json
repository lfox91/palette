{
  "name": "@leafox/palette",
  "version": "0.1.0",
  "description": "Sun-aware Ptyxis palette generator and scheduler — generates perceptually-tuned terminal color schemes and cycles them by position relative to the sun.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfox91/palette.git"
  },
  "homepage": "https://github.com/lfox91/palette#readme",
  "bugs": {
    "url": "https://github.com/lfox91/palette/issues"
  },
  "bin": {
    "palette": "./dist/cli.js"
  },
  "files": [
    "dist",
    "packaging/systemd",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.js",
    "build:binary": "bun build src/cli.ts --compile --target=bun-linux-x64-baseline --outfile=dist/palette",
    "lint": "biome lint src test scripts",
    "format": "biome format --write src test scripts",
    "check": "biome check --write src test scripts",
    "proofs": "bun run src/proof-cli.ts",
    "scan:secrets": "bun run scripts/scan-secrets.ts",
    "audit": "bun audit",
    "security": "bun run scan:secrets && bun run audit && bun run typecheck",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.14.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=20"
  }
}
